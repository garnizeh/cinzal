# Local Claude Code state — per-machine, never shared. The skills and the
# workflow harness under .claude/ ARE committed; only this local state is not.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/journal.md

# Compiled binaries
/bin/
/cinzal
/simulate
/replay
*.exe
*.dll
*.so
*.dylib

# Test and coverage output
*.test
*.out
coverage.*
/testdata/tmp/

# Local ad-hoc `make bench > x.bench` before/after comparisons (issue #112)
# — a personal aid, never committed. CI's own recorded history is the
# workflow artifact the bench job uploads, not a file in the tree.
*.bench

# Go workspace files (per-machine)
go.work
go.work.sum

# Environment and secrets
.env
.env.*
!.env.example

# Simulation harness output (cmd/simulate sweeps)
/sweeps/
/*.csv

# Editors and OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# NOTE: generated code is deliberately NOT ignored.
# `templ generate` and `sqlc generate` output is committed, and CI asserts
# it is current — see docs/project/cinzal-implementation-plan.md, M0.
